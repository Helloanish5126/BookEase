# ==========================================
# BookEase - Git Ignore
# ==========================================

# Node / React
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local

# Spring Boot / Java
backend/target/
*.class

# Local Spring configuration
# Contains local database credentials
backend/src/main/resources/application.properties

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.temp